# Build output
/target
**/target

# soroban-sdk writes a snapshot per test environment at drop unless the harness
# disables it; the fuzzer does, but ordinary soroban tests do not.
test_snapshots/

# proptest's persisted regressions (only written when explicitly enabled)
**/proptest-regressions/

# Failure reports produced by `FuzzConfig::report_path`
fuzz-report.json
*.fuzz-report.json

# Benchmark output captured by CI and by `cargo bench | tee bench.txt`
bench.txt

# Reports written by the CI jobs, which run the tools with their stdout redirected:
# the analyser's SARIF, and the coverage job's lcov.
analysis.sarif
lcov.info

# What the GitHub Action writes when it is run locally, and the log the script keeps.
soroban-analyzer.sarif
analysis.stderr
